<x-filament-panels::page.simple>
    <div class="core-login-wrapper">
        {{-- PANEL KIRI: BRANDING --}}
        <section class="core-login-brand">
            <div class="core-brand-top">
                <div class="core-brand-logo">C<span>.</span></div>
                <span class="core-brand-label">ADMINISTRATION PORTAL</span>
            </div>

            <div class="core-brand-content">
                <span class="core-eyebrow">
                    <span class="core-status-dot"></span>
                    SYSTEM MANAGEMENT
                </span>

                <h1>Built for<br>Performance.</h1>

                <p>
                    Manage your hardware business with precision.
                    One platform to control products, orders, and operations.
                </p>

                <div class="core-hardware-art" aria-hidden="true">
                    <div class="core-art-ring core-art-ring-one"></div>
                    <div class="core-art-ring core-art-ring-two"></div>

                    <div class="core-chip">
                        <div class="core-chip-inner">
                            <span>CORE</span>
